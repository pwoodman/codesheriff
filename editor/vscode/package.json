{
  "name": "the-code-sheriff",
  "displayName": "The Code Sheriff",
  "description": "AI code review with bug detection, security scanning, and auto-fix suggestions",
  "version": "1.18.0",
  "publisher": "the-code-sheriff",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Security",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "theCodeSheriff.refresh",
        "title": "The Code Sheriff: Refresh findings"
      },
      {
        "command": "theCodeSheriff.fix",
        "title": "The Code Sheriff: Fix finding"
      },
      {
        "command": "theCodeSheriff.explain",
        "title": "The Code Sheriff: Explain finding"
      },
      {
        "command": "theCodeSheriff.openReport",
        "title": "The Code Sheriff: Open HTML report"
      },
      {
        "command": "theCodeSheriff.oracle",
        "title": "The Code Sheriff: Run oracle (fix playbook)"
      }
    ],
    "codeActions": [
      {
        "id": "theCodeSheriff.quickFix",
        "languages": ["*"],
        "actions": [
          {
            "command": "theCodeSheriff.fix",
            "title": "Fix with Code Sheriff",
            "kind": "quickfix"
          },
          {
            "command": "theCodeSheriff.explain",
            "title": "Explain with Code Sheriff",
            "kind": "quickfix"
          }
        ]
      }
    ]
  }
}
